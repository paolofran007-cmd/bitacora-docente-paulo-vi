rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowedEmail() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in [
        "cyntia.miran@paulovi.edu.ar",
        "ominetti.gabriel@paulovi.edu.ar",
        "pugliese.josemaria@paulovi.edu.ar",
        "juanpablo.moyano@paulovi.edu.ar",
        "rissopatron.juandaniloefrain@paulovi.edu.ar",
        "namuncura.alexis@paulovi.edu.ar",
        "gianello.orieta@paulovi.edu.ar",
        "melody_loncon@paulovi.edu.ar",
        "paolo.etchepareborda@paulovi.edu.ar"
      ];
    }
    match /bitacora/{entryId} {
      allow read, create, update, delete: if allowedEmail();
    }
  }
}